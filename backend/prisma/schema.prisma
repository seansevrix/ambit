// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunitySegment {
  government
  commercial
  residential
}

model Customer {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  passwordHash String? // ✅ added (for login)

  phone       String?
  industry    String?
  location    String?
  serviceArea String? // ✅ added (frontend sends this)
  services    String?

  // ✅ selected markets from onboarding (multi-select)
  segments OpportunitySegment[]

  // ✅ where to ingest from (future-proof)
  // ex: ["sam","opengov"] or ["opengov"]
  sources String[]

  // comma-separated
  keywords String?

  // comma-separated (ex: 237310,238220)
  naics String?

  // ✅ NAICS as a real array too (frontend sends this)
  naicsCodes String[]

  // Stripe / subscription gating
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?
  isActive             Boolean @default(false)

  // ✅ NEW: No-CC trial
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  // ✅ Digest settings
  digestEnabled    Boolean   @default(true)
  lastDigestSentAt DateTime?

  // ✅ Existing digest email send log (daily dedupe)
  digestEmails DigestEmail[]

  // ✅ NEW: Quiet-mode log (tracks MATCH / NO_MATCH / DAY + dedupe + cooldown)
  digestLogs DigestLog[]

  // ✅ Integrations
  thumbtackIntegration ThumbtackIntegration?
  thumbtackEvents      ThumbtackWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ✅ NEW: General-purpose digest log (recommended for quiet mode)
model DigestLog {
  id         String   @id @default(cuid())
  customerId Int
  type       String   // "MATCH" | "NO_MATCH" | "DAY"
  key        String   @unique
  meta       Json?
  sentAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, sentAt])
}

model DigestEmail {
  id         Int    @id @default(autoincrement())
  customerId Int
  digestDate String // "YYYY-MM-DD" (UTC day key)

  status   String  @default("running") // running | sent | failed
  resendId String?
  error    String?

  matchKey   String?
  matchTitle String?
  matchUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, digestDate], name: "customerId_digestDate")
  @@index([customerId, matchKey])
}

model Opportunity {
  id      Int                @id @default(autoincrement())
  segment OpportunitySegment @default(government)

  // where it came from (sam, opengov, planhub, thumbtack, etc.)
  source     String  @default("sam")
  externalId String? // source's unique ID for upsert (required for ingestion)
  url        String?

  title    String
  location String

  // gov uses NAICS; residential/commercial can leave empty
  naics String @default("")

  // general enrichment
  keywords   String?
  agency     String?
  postedDate DateTime?
  dueDate    DateTime?
  summary    String?

  // non-gov fields
  category  String? // trade / service category (roofing, concrete, HVAC, etc.)
  valueText String? // "$35k-$65k" or "TBD"
  status    String? // open / won / lost / in-progress / etc.

  // optional debugging payload storage
  raw Json?

  // ✅ opposite relation field for ThumbtackWebhookEvent.opportunity
  thumbtackEvents ThumbtackWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([segment])
  @@index([source])
}
model LiveOpportunity {
  id      Int                @id @default(autoincrement())
  segment OpportunitySegment @default(government)

  // where it came from (sam.gov, opengov, planhub, etc.)
  source     String
  externalId String?
  sourceUrl  String

  // public page fields
  slug     String @unique
  title    String
  buyer    String?
  location String?
  state    String?
  naics    String?
  category String?
  status   String?
  noticeType String?

  // content shown on public cards/detail pages
  summaryShort String?
  summaryLong  String?

  postedDate DateTime?
  dueDate    DateTime?
  isActive   Boolean @default(true)

  // optional debugging/raw source payload
  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@unique([source, sourceUrl])
  @@index([segment])
  @@index([source])
  @@index([state])
  @@index([category])
  @@index([dueDate])
  @@index([isActive])
}
model ThumbtackIntegration {
  id         Int      @id @default(autoincrement())
  customerId Int      @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Thumbtack business id that webhooks attach to
  businessId String?

  accessToken  String
  refreshToken String?
  tokenType    String?
  scope        String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThumbtackWebhookEvent {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  // what Thumbtack says this event is
  eventType String

  // negotiation id / message id / etc (if present)
  externalId String?

  // raw webhook JSON
  payload Json

  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?

  // if we create/update an opportunity from this event
  opportunityId Int?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([eventType])
  @@index([externalId])
  @@index([processed])
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
